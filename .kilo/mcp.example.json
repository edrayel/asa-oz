{
  "mcp": {
    "ssh-connect": {
      "type": "local",
      "timeout": 30000,
      "command": ["<path-to-ssh-connect-binary>"],
      "environment": {
        "SSH_HOST": "<vps-host>",
        "SSH_USER": "<ssh-user>",
        "SSH_KEY_PATH": "<path-to-private-key>"
      },
      "enabled": true
    },
    "github-edrayel": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer <github-personal-access-token>"
      }
    }
  }
}
