# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Local env
.env
.env.local

# Dependencies / build (none currently, reserved)
node_modules/
dist/
.cache/

# Logs
*.log

# MCP config (contains API keys — never commit)
.mcp.json

# Mail / SMTP credentials (never commit — see DEPLOY.md)
zoho-mail-cred-info-*.txt
*cred-info*.txt
*credentials*.txt

# Google OAuth client secrets (never commit — the Drive integration reads
# GOOGLE_DRIVE_CREDENTIALS from the environment instead)
client_secret*.json
*client_secret*.json
gcloud_*.txt
*google*credentials*.json
*oauth_token*.json

# Python
__pycache__/
*.pyc
.venv/

# Flask instance (local db, secrets)
instance/

# Uploaded media (bytes; DB stores paths only)
instance/uploads/

# Test artifacts
.playwright-mcp/
admin-dashboard.png

# Verification screenshots
*.png
# Playwright snapshot dumps (scoped: a bare *.yml would also hide
# docker-compose.yml, which belongs in the repo)
.playwright-mcp/*.yml
*.playwright.yml

# Legacy source copy directories
webcopy/
feedback/

# Knowledge-graph output (generated)
graphify-out/

# Docker Compose data directory (the persistent volume mount target)
data/
